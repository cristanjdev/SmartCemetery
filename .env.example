# Smart Cemetery Platform — Environment Variables
# Copy this file to .env.local and fill in your values

# Database — MySQL connection string. XAMPP's default is user root, no password,
# port 3306 (start MySQL in the XAMPP Control Panel). `npm run db:setup` finds it
# and fills this in for you.
DATABASE_URL="mysql://root:password@localhost:3306/cemetery_map"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Database-backed throttling. Identifiers are SHA-256 hashed before storage.
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
SEARCH_RATE_LIMIT_MAX="60"
SEARCH_RATE_LIMIT_WINDOW_SECONDS="60"

# Google Maps JavaScript API — required for the interactive map (§4.9, §7).
# Create the key in Google Cloud Console with the Maps JavaScript API, Directions
# API, and Geocoding API enabled, then restrict it by HTTP referrer (your site
# domains) and by API. The key is exposed to the browser by design; the referrer
# and API restrictions are what protect it. Never commit a real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Legacy raster-tile fallback (only used if the app is reverted to a non-Google
# map). Not used while Google Maps is active. Public OpenStreetMap tiles are a
# development fallback only.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""

# AES-256 encryption key lifecycle
# ENCRYPTION_KEY is the current 32-byte hex key. Increment the version before
# rotation and keep prior version keys in the JSON keyring until every row has
# been re-encrypted and verified. Never commit real keys.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY_VERSION="v1"
ENCRYPTION_KEY_PREVIOUS="{}"
# Safety confirmation required by npm run db:rotate-encryption.
ROTATE_ENCRYPTION_CONFIRM=""

# Map center — configurable default coordinates for the cemetery map (Req 13.1)
# If unset, invalid, non-numeric, out of range, or partial, the app falls back
# to the documented default center (8.4647, 124.6578).
# Valid ranges: MAP_CENTER_LAT [-90..90], MAP_CENTER_LNG [-180..180]
MAP_CENTER_LAT="8.4647"
MAP_CENTER_LNG="124.6578"

# Client-exposed map center (Req 13.4). The Leaflet map components run in the
# browser, so the center must be exposed via NEXT_PUBLIC_ prefixed variables
# (inlined at build time). Keep these in sync with MAP_CENTER_LAT/LNG above.
# If unset, invalid, non-numeric, out of range, or partial, the map falls back
# to the documented default center (8.4647, 124.6578).
NEXT_PUBLIC_MAP_CENTER_LAT="8.4647"
NEXT_PUBLIC_MAP_CENTER_LNG="124.6578"

# Cemetery-specific pedestrian routing — required in production (Req 12)
# Point this at a managed or self-hosted OSRM-compatible service built from the
# surveyed cemetery walkable-path graph. The browser calls only /api/routing;
# provider endpoints and credentials remain server-side. Public OSRM is a
# development-only fallback.
ROUTING_BASE_URL="https://routing.example.gov.ph"
ROUTING_PROFILE="foot"
ROUTING_TIMEOUT_MS="8000"
ROUTING_MAX_RADIUS_METERS="5000"

# Public routing endpoint rate limit (per client IP) — protects the shared
# routing provider from quota/cost abuse on the public directions endpoint.
ROUTING_RATE_LIMIT_MAX="120"
ROUTING_RATE_LIMIT_WINDOW_SECONDS="60"

# Scheduled archival credential and schedule
# Invoke POST /api/archival once daily (recommended: shortly after midnight UTC).
# Supply x-archival-token and optionally x-archival-run-key. When omitted, the
# run key defaults to daily:YYYY-MM-DD (UTC). Successful duplicate keys return
# the prior run; overlapping runs return HTTP 409. GET /api/archival is Admin-only.
ARCHIVAL_CRON_SECRET="change-this-archival-cron-secret"
# Optional: user id used as the audit actor for cron-triggered archival, since
# the scheduled path has no user session (UserLog.userId is a required FK).
# When unset, cron-triggered archival records its outcome via a server log.
ARCHIVAL_SYSTEM_USER_ID=""

# Email notifications (SMTP) — optional (Req 9.3)
# When left unset, notifications are delivered in-app only. Set all SMTP_* values
# and EMAIL_FROM to enable outbound email notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Smart Cemetery <no-reply@example.com>"
# Port 465 normally uses implicit TLS (secure=true). Port 587 normally uses
# STARTTLS (secure=false, requireTLS=true). Keep certificate checks enabled.
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_TLS_REJECT_UNAUTHORIZED="true"
SMTP_CONNECTION_TIMEOUT_MS="10000"
SMTP_GREETING_TIMEOUT_MS="10000"
SMTP_SOCKET_TIMEOUT_MS="30000"

# Explicit seed credentials (required by npm run db:seed; minimum 12 chars).
# These emails are the app's defaults (the sign-in form, `npm run db:setup` and
# the seed all use them). `db:setup` fills empty passwords for a local database
# and prints the final emails and passwords. List what exists: npm run db:users
SEED_ADMIN_EMAIL="admin@cemetery.gov.ph"
SEED_ADMIN_PASSWORD=""
SEED_STAFF_EMAIL="staff@cemetery.gov.ph"
SEED_STAFF_PASSWORD=""
SEED_CLIENT_EMAIL="visitor@example.com"
SEED_CLIENT_PASSWORD=""

# Optional seed extras (default: users only). "yes" enables.
#   SEED_DEMO_DATA      sample sections, invented burial records, requests, feedback
#   SEED_LAYOUT_PRESET  plot layout from src/lib/layout-preset.json (no burial records)
# `npm run db:setup` turns both on for a LOCAL database only.
# SEED_DEMO_DATA=
# SEED_LAYOUT_PRESET=
# Refused when NODE_ENV=production unless ALLOW_DEMO_DATA_IN_PRODUCTION=yes.

# Name of the location the layout preset attaches to (used to find an existing
# location and to name a new one). Default: the preset file's location.name.
# LAYOUT_LOCATION_NAME=

# Number of trusted reverse proxies in front of the app (0/unset = read the
# left-most X-Forwarded-For entry, which is only safe if your edge proxy
# overwrites that header). Set to 1 behind a single proxy/load balancer so the
# client IP used for rate limiting cannot be spoofed.
TRUSTED_PROXY_COUNT=

# Site identity and layout defaults (all optional; shown values are the defaults)
# NEXT_PUBLIC_SITE_NAME="Bolonsori Public Cemetery"
# NEXT_PUBLIC_SITE_SHORT_NAME="Bolonsori"
# NEXT_PUBLIC_GRID_ANGLE=37.7
# NEXT_PUBLIC_DEFAULT_BUILDING_TIERS=4
