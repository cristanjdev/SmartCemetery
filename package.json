    "test:e2e:roles": "playwright test e2e/roles.pw.spec.js",
    "test:mysql": "node scripts/test-mysql.js",
    "test:release": "npm run lint && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-db.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:setup": "node scripts/setup-db.js",
    "db:upgrade-layout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/upgrade-layout.js",
    "db:rotate-encryption": "node scripts/rotate-encryption.js",
    "db:backfill-tiers": "node scripts/backfill-tiers.js",
    "db:backfill-phonetic": "node scripts/backfill-phonetic.js",
