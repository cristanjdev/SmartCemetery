    "next-auth": "4.24.14",
    "nodemailer9": "npm:nodemailer@9.0.3",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fast-check": "^4.9.0",
    "jiti": "^2.7.0",
    "prisma": "^6.9.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.19",
    "uuid": "11.1.1"
