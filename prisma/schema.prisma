// Smart Cemetery Navigation and Monitoring Platform
// Database Schema — MySQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMERATED VALUES ────────────────────────────────────────
// Fixed value sets are real MySQL ENUM columns, so the database rejects typos
// and stores one byte per value instead of a VARCHAR.

enum AccountStatus {
  active
  disabled
}

enum PlotStatus {
  available
  occupied
  reserved
  maintenance
}

enum GraveStatus {
  active
  archived
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum RequestType {
  reservation
  record_update
  inquiry
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum RequestOutcome {
  approved
  rejected
}

enum NotificationCategory {
  request_outcome
  broadcast
}

enum EmailStatus {
  none
  sent
  failed
  skipped
}

enum BroadcastAudience {
  All
  Admin
  Staff
  Client
}

enum BroadcastStatus {
  processing
  sent
  failed
  partial
}

enum NavigationChannel {
  dashboard
  kiosk
  public
}

enum NavigationOutcome {
  success
  failed
}

enum ArchivalSource {
  admin
  cron
}

enum ArchivalStatus {
  running
  success
  failed
}

// ─── USER MANAGEMENT ──────────────────────────────────────────

model UserType {
  id       Int    @id @default(autoincrement())
  typeName String @unique @map("type_name") @db.VarChar(20)
  users    User[]

  @@map("user_types")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  userTypeId   Int      @map("user_type_id")
  status       AccountStatus @default(active)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userType             UserType            @relation(fields: [userTypeId], references: [id])
  logs                 UserLog[]
  requests             Request[]
  feedbacks            Feedback[]
  navigations          Navigation[]
  notifications        Notification[]
  deactivatedLocations Location[]          @relation("LocationDeactivatedBy")
  verifiedGraves       Grave[]             @relation("GraveVerifiedBy")
  broadcasts           Broadcast[]
  broadcastDeliveries  BroadcastDelivery[]

  @@map("users")
}

// ─── LOCATION MANAGEMENT ──────────────────────────────────────

model Location {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  description     String?   @db.Text
  gpsLat          Decimal?  @map("gps_lat") @db.Decimal(10, 8)
  gpsLng          Decimal?  @map("gps_lng") @db.Decimal(11, 8)
  isActive        Boolean   @default(true) @map("is_active")
  deactivatedAt   DateTime? @map("deactivated_at")
  deactivatedById Int?      @map("deactivated_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  details       LocationDetail[]
  deactivatedBy User?            @relation("LocationDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull)

  @@index([isActive, name])
  @@map("locations")
}

model LocationDetail {
  id         Int      @id @default(autoincrement())
  locationId Int      @map("location_id")
  subsection String   @db.VarChar(50)
  sortOrder  Int      @default(0) @map("sort_order")
  capacity   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  plots    Plot[]

  @@index([locationId, sortOrder])
  @@map("location_details")
}

// ─── PLOT & GRAVE MANAGEMENT ──────────────────────────────────

model Plot {
  id               Int      @id @default(autoincrement())
  locationDetailId Int      @map("location_detail_id")
  plotNumber       String   @map("plot_number") @db.VarChar(30)
  status           PlotStatus @default(available)
  // Number of burial tiers/niches in this plot (1 for a ground lot, 4 for an
  // apartment crypt stack). Tier occupants are the plot's Grave rows.
  totalTiers       Int      @default(1) @map("total_tiers")
  gpsLat           Decimal? @map("gps_lat") @db.Decimal(10, 8)
  gpsLng           Decimal? @map("gps_lng") @db.Decimal(11, 8)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  locationDetail LocationDetail @relation(fields: [locationDetailId], references: [id], onDelete: Restrict)
  graves         Grave[]
  photos         PlotPhoto[]
  navigations    Navigation[]

  @@unique([locationDetailId, plotNumber])
  @@map("plots")
}

model Grave {
  id                 Int       @id @default(autoincrement())
  plotId             Int       @map("plot_id")
  tier               Int       @default(1)
  deceasedName       String    @map("deceased_name") @db.VarChar(200)
  // Phonetic index key: space-separated Double Metaphone tokens of the name
  // (see phoneticIndexKey in src/lib/search.js). Backs the FULLTEXT index that
  // powers "did you mean" suggestions inside the database.
  namePhonetic       String    @default("") @map("name_phonetic") @db.VarChar(500)
  birthDate          DateTime? @map("birth_date") @db.Date
  deathDate          DateTime? @map("death_date") @db.Date
  burialDate         DateTime? @map("burial_date") @db.Date
  status             GraveStatus @default(active)
  archivedAt         DateTime? @map("archived_at")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  verifiedAt         DateTime? @map("verified_at")
  verifiedById       Int?      @map("verified_by_id")
  verificationNote   String?   @map("verification_note") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  plot       Plot         @relation(fields: [plotId], references: [id], onDelete: Restrict)
  details    GraveDetail?
  verifiedBy User?        @relation("GraveVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([plotId, tier])
  @@index([burialDate])
  @@index([status, verificationStatus])
  @@fulltext([namePhonetic])
  @@map("graves")
}

// Photo of a plot or one of its tiers. `tier` 0 is the plot-wide photo;
// 1..N is a specific tier. One photo per (plot, tier).
model PlotPhoto {
  id        Int      @id @default(autoincrement())
  plotId    Int      @map("plot_id")
  tier      Int      @default(0)
  url       String   @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@unique([plotId, tier])
  @@map("plot_photos")
}

model GraveDetail {
  id                   Int      @id @default(autoincrement())
  graveId              Int      @unique @map("grave_id")
  causeOfDeath         String?  @map("cause_of_death") @db.Text
  contactPerson        String?  @map("contact_person") @db.Text
  contactPhone         String?  @map("contact_phone") @db.Text
  // Free-text remarks only (encrypted). Structured data lives in real columns.
  notes                String?  @db.Text
  encryptionKeyVersion String   @default("v1") @map("encryption_key_version") @db.VarChar(40)
  notesEncrypted       Boolean  @default(false) @map("notes_encrypted")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  grave Grave @relation(fields: [graveId], references: [id], onDelete: Cascade)

  @@map("grave_details")
}

// ─── INTERACTION & MONITORING ─────────────────────────────────

model UserLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("user_logs")
}

model Request {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        RequestType
  description String   @db.Text
  status      RequestStatus @default(pending)
  referenceId String   @unique @map("reference_id") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([status, createdAt])
  @@map("requests")
}

model Notification {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  requestId   Int?      @map("request_id")
  broadcastId Int?      @map("broadcast_id")
  referenceId String?   @map("reference_id") @db.VarChar(20)
  outcome     RequestOutcome?
  category    NotificationCategory @default(request_outcome)
  title       String    @default("Notification") @db.VarChar(160)
  message     String?   @db.Text
  emailStatus EmailStatus @default(none) @map("email_status")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  request   Request?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([broadcastId])
  @@map("notifications")
}

model Broadcast {
  id        Int       @id @default(autoincrement())
  creatorId Int       @map("creator_id")
  audience  BroadcastAudience
  title     String    @db.VarChar(160)
  message   String    @db.Text
  status    BroadcastStatus @default(processing)
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  creator       User                @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  notifications Notification[]
  deliveries    BroadcastDelivery[]

  @@index([createdAt])
  @@map("broadcasts")
}

model BroadcastDelivery {
  id          Int      @id @default(autoincrement())
  broadcastId Int      @map("broadcast_id")
  userId      Int      @map("user_id")
  emailStatus EmailStatus @default(none) @map("email_status")
  attempts    Int      @default(0)
  error       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([userId, createdAt])
  @@map("broadcast_deliveries")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  rating    Int      @db.TinyInt
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Navigation {
  id              Int      @id @default(autoincrement())
  userId          Int?     @map("user_id")
  plotId          Int?     @map("plot_id")
  origin          String?  @db.VarChar(255)
  destination     String   @db.VarChar(255)
  channel         NavigationChannel @default(dashboard)
  outcome         NavigationOutcome @default(success)
  distanceMeters  Int?     @map("distance_meters")
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  plot Plot? @relation(fields: [plotId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([channel, createdAt])
  @@index([plotId, createdAt])
  @@map("navigations")
}

model ArchivalRun {
  id            Int       @id @default(autoincrement())
  runKey        String    @unique @map("run_key") @db.VarChar(80)
  source        ArchivalSource
  status        ArchivalStatus @default(running)
  archivedCount Int       @default(0) @map("archived_count")
  error         String?   @db.VarChar(500)
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  @@index([startedAt])
  @@map("archival_runs")
}

model RateLimitBucket {
  key       String   @id @map("bucket_key") @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ─── APPLICATION SETTINGS ─────────────────────────────────────

// Small key/value store for shared, non-relational settings such as the
// cemetery boundary polygon edited from the map. Values are JSON strings.
model AppSetting {
  key       String   @id @map("setting_key") @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
