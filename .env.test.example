# Settings used ONLY by the automated test tools. The running app never reads
# them, and a normal install does not need this file. Leave it out of your .env
# / .env.local unless you run the checks below.
#
# To use: copy these lines into .env.local.

# Disposable live-MySQL tests. The database name must contain "test", must not
# equal DATABASE_URL, and the explicit confirmation flag is required.
TEST_DATABASE_URL="mysql://root:password@localhost:3306/cemetery_test"
ALLOW_LIVE_MYSQL_TESTS="no"

# Authenticated Playwright roles (normally mapped to the disposable seed users)
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
E2E_STAFF_EMAIL=""
E2E_STAFF_PASSWORD=""
E2E_CLIENT_EMAIL=""
E2E_CLIENT_PASSWORD=""
